  "items": [
    {
      "id": "sn01",
      "category": "snack",
      "icon": "nut", "tone": "campus",
      "text": "Bir avuç ceviz ye.",
      "why": "Arjinin ve bitkisel omega-3 içerir; damar sağlığını destekler.",
      "source": {
        "title": "Esposito ve ark. (2006) – Akdeniz diyeti ve erektil fonksiyon",
        "url": "https://pubmed.ncbi.nlm.nih.gov/16395320/"
      }
    },
    {
      "id": "sn02",
      "category": "snack",
      "icon": "nut", "tone": "campus",
      "text": "Bir avuç tuzsuz antep fıstığı ye.",
      "why": "Arjinin ve antioksidanlardan zengindir.",
      "source": {
        "title": "L-arjinin ve erektil fonksiyon – meta-analiz (2021)",
        "url": "https://pubmed.ncbi.nlm.nih.gov/33587304/"
      }
    },
    {
      "id": "sn03",
      "category": "snack",
      "icon": "nut", "tone": "campus",
      "text": "Bir avuç çiğ badem ye.",
      "why": "Magnezyum ve E vitamini kaynağıdır.",
      "source": {
        "title": "NIH ODS – Magnezyum",
        "url": "https://ods.od.nih.gov/factsheets/Magnesium-Consumer/"
      }
    },
    {
      "id": "sn04",
      "category": "snack",
      "icon": "nut", "tone": "campus",
      "text": "Yoğurduna ya da salatana 1 yemek kaşığı kabak çekirdeği ekle.",
      "why": "Testosteron üretimi için gerekli çinkonun iyi kaynaklarındandır.",
      "source": {
        "title": "NIH ODS – Çinko",
        "url": "https://ods.od.nih.gov/factsheets/Zinc-Consumer/"
      }
    },
    {
      "id": "sn05",
      "category": "snack",
      "icon": "cookie", "tone": "campus",
      "text": "1–2 kare %70+ kakaolu bitter çikolata ye.",
      "why": "Kakao flavanolleri damar iç yüzeyinin işlevini destekler.",
      "source": {
        "title": "Cassidy ve ark. (2016) – Flavonoid alımı ve erektil disfonksiyon, AJCN",
        "url": "https://ueaeprints.uea.ac.uk/id/eprint/57156/"
      }
    },
    {
      "id": "sn06",
      "category": "snack",
      "icon": "nut", "tone": "campus",
      "text": "1 adet Brezilya cevizi ye; fazlasını değil.",
