{
  "reviewed": false,
  "exercises": [
    {
      "id": "glute_bridge",
      "name": "Glute Bridge",
      "target": "Glutes, hamstrings, pelvic floor",
      "setup": "Lie on your back, knees bent, feet flat.",
      "steps": [
        "Squeeze and lift your hips.",
        "Pause at the top.",
        "Lower slowly."
      ],
      "tip": "Lift your pelvic floor too.",
      "mistake": "Don't overarch your back."
    },
    {
      "id": "pelvic_tilt",
      "name": "Pelvic Tilt",
      "target": "Lower abs and pelvic floor",
      "setup": "Lie on your back, knees bent.",
      "steps": [
        "Press your lower back down.",
        "Tilt your pelvis up slightly.",
        "Release."
      ],
      "tip": "A small move; hips stay down.",
      "mistake": "Don't hold your breath."
    },
    {
      "id": "pillow_squeeze",
      "name": "Pillow Squeeze",
      "target": "Inner thighs and pelvic floor",
      "setup": "Lie on your back, pillow between knees.",
      "steps": [
        "Squeeze the pillow.",
        "Lift your pelvic floor.",
        "Release slowly."
      ],
      "tip": "Breathe out as you squeeze.",
      "mistake": "Don't lift your hips."
    },
    {
      "id": "clamshell",
      "name": "Clamshell",
      "target": "Side hip muscles",
      "setup": "Lie on your side, knees bent, feet together.",
      "steps": [
        "Open your top knee.",
        "Pause at the top.",
        "Close slowly."
      ],
      "tip": "Switch sides halfway.",
      "mistake": "Don't roll your hips back."
    },
    {
      "id": "knee_to_chest",
      "name": "Knee-to-Chest Stretch",
      "target": "Lower back and hips (relax)",
      "setup": "Lie on your back, knees bent.",
      "steps": [
        "Pull your knees to your chest.",
        "Breathe in, hold.",
        "Breathe out, draw closer."
      ],
      "tip": "Head and shoulders stay down.",
      "mistake": "Don't force it."
    },
    {
      "id": "dead_bug",
      "name": "Dead Bug",
      "target": "Deep core and balance",
      "setup": "On your back; arms up, knees at 90°.",
      "steps": [
        "Reach one arm and the opposite leg.",
        "Keep your back down.",
        "Return, switch sides."
      ],
      "tip": "Switch sides every rep.",
      "mistake": "If your back lifts, reach less."
    },
    {
      "id": "squat",
      "name": "Squat",
      "target": "Hips and legs",
      "setup": "Feet shoulder-width apart.",
      "steps": [
        "Sit your hips back and down.",
        "Keep your chest up.",
        "Push through your heels."
      ],
      "tip": "Breathe out as you rise.",
      "mistake": "Don't let your knees cave in."
    },
    {
      "id": "sumo_squat",
      "name": "Sumo Squat",
      "target": "Inner thighs, hips, pelvic floor",
      "setup": "Wide stance, toes out.",
      "steps": [
        "Open your knees and lower.",
        "Knees over your toes.",
        "Squeeze as you rise."
      ],
      "tip": "Lift your pelvic floor as you rise.",
      "mistake": "Don't lean forward."
    },
    {
      "id": "plank",
      "name": "Plank",
      "target": "Abs and core",
      "setup": "Elbows under shoulders, on your toes.",
      "steps": [
        "Body in a straight line.",
        "Draw your belly in gently.",
        "Hold and breathe."
      ],
      "tip": "Drop to your knees if needed.",
      "mistake": "Don't let your hips sag."
    },
    {
      "id": "bird_dog",
      "name": "Bird-Dog",
      "target": "Back, hips, balance",
      "setup": "Start on all fours.",
      "steps": [
        "Reach one arm and the opposite leg.",
        "Pause briefly.",
        "Return, switch sides."
      ],
      "tip": "Switch sides every rep.",
      "mistake": "Don't let your back sag."
    },
    {
      "id": "hip_opener",
      "name": "Hip Opener Stretch",
      "target": "Front of the hip (stretch)",
      "setup": "One knee down, other foot in front.",
      "steps": [
        "Push your hips forward.",
        "Feel the stretch at the back hip.",
        "Come back slowly."
      ],
      "tip": "Switch legs halfway.",
      "mistake": "Don't lean too far forward."
    },
    {
      "id": "butterfly",
      "name": "Butterfly Stretch",
      "target": "Inner thighs and groin (stretch)",
      "setup": "Sit with the soles of your feet together.",
      "steps": [
        "Breathe in, sit tall.",
        "Breathe out, let your knees drop.",
        "Relax a little more each breath."
      ],
      "tip": "Don't push your knees down.",
      "mistake": "Don't round your back."
    }
  ],
